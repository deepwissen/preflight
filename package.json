{
  "name": "@deepwissen/preflight",
  "version": "0.6.0",
  "description": "Get your AI agent flight-ready — inventory, scope, and scan the skills it carries, before it flies.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "preflight": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deepwissen/preflight.git"
  },
  "homepage": "https://github.com/deepwissen/preflight#readme",
  "keywords": [
    "ai",
    "claude",
    "skills",
    "agent",
    "security",
    "preflight"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:floor": "node scripts/check-engine-floor.mjs",
    "qa:skills": "node qa/harness.mjs ./skills.mjs \"node ./dist/bin.js\"",
    "qa:config": "node qa/harness.mjs ./config.mjs \"node ./dist/bin.js\"",
    "qa": "npm run qa:skills && npm run qa:config",
    "qa:fp-gate": "PF=\"node ./dist/bin.js\" bash scripts/qa-fp-gate.sh",
    "prepublishOnly": "npm ci && npm run build && npm test && npm run qa && npm run qa:fp-gate"
  },
  "dependencies": {
    "@deepwissen/preflight-core": "^0.1.37"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
